# hosts.env.example — config ของ scripts/deploy.sh (Hostinger · sharedheritage.net)
#
# ลำดับค่า: env ของ shell > scripts/deploy/hosts.env (ไม่ commit · .gitignore) > ไฟล์นี้
# รูปแบบ: KEY=VALUE บรรทัดละค่า (ไม่ถูก source เป็น shell — อ่านเฉพาะ key ที่รู้จัก ไม่มีการรันโค้ด)
# ⛔ ห้ามใส่รหัสผ่าน / token / private key ในไฟล์ใดๆ ที่นี่ — host/path/user ไม่ใช่ความลับ
#
# WP path ด้านล่าง = ค่าจริงที่ orchestrator อ่านจาก server (2026-10-27) · ยืนยันซ้ำได้ด้วย
# `scripts/deploy.sh staging --discover` (อ่านอย่างเดียว) · ค่าต่างจากนี้ → คัดลอกเป็น hosts.env แล้วแก้ที่นั่น

# --- SSH (DEPLOY.md §การเข้าถึง) ---
SH_DEPLOY_SSH_HOST=156.67.222.233
SH_DEPLOY_SSH_PORT=65002
SH_DEPLOY_SSH_USER=u972755030
SH_DEPLOY_SSH_KEY=~/.ssh/sharedheritage_hostinger

# โฟลเดอร์งานบน server — relative กับ home ของ user (นอก webroot): tmp import · backups · logs
SH_DEPLOY_REMOTE_DIR=sh-deploy

# --- staging (Hostinger staging = WP + DB แยก) ---
SH_STAGING_URL=https://staging.sharedheritage.net
SH_STAGING_WP_PATH=/home/u972755030/domains/sharedheritage.net/public_html/staging

# --- production (ต้องมี orchestrator/deploy-approved) ---
# ⛔ ต้องตั้งค่าเสมอ แม้ deploy staging — ใช้กันไม่ให้ staging ชี้ไป production (URL host ซ้ำ / path ซ้ำ / staging ครอบ prod = หยุด)
SH_PRODUCTION_URL=https://sharedheritage.net
SH_PRODUCTION_WP_PATH=/home/u972755030/domains/sharedheritage.net/public_html

# --- ไฟล์นอก repo ที่ import ใช้ (ว่าง = Unesco/design/assets · Unesco/media/out เหมือน scripts/local.sh) ---
SH_DESIGN_ASSETS=
SH_MEDIA_OUT=
